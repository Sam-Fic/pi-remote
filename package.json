{
    "name": "@mjasnikovs/pi-remote",
    "version": "0.1.0",
    "description": "Material Design remote-control web view for pi — real-time WebSocket server, session sidebar, web push, and an mdui/M3 WebUI, extracted from pi-task.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
        "lint:check": "tsc --noEmit",
        "test": "cross-env AGENT=1 bun test --isolate test/"
    },
    "peerDependencies": {
        "@earendil-works/pi-coding-agent": ">=0.80.0",
        "@earendil-works/pi-agent-core": ">=0.80.0",
        "@earendil-works/pi-tui": ">=0.80.0"
    },
    "dependencies": {
        "qrcode": "1.5.4",
        "web-push": "3.6.7",
        "ws": "8.21.0"
    },
    "devDependencies": {
        "@earendil-works/pi-agent-core": "0.84.2",
        "@earendil-works/pi-coding-agent": "0.84.2",
        "@earendil-works/pi-tui": "0.84.2",
        "@types/bun": "1.3.12",
        "@types/qrcode": "1.5.6",
        "@types/web-push": "3.6.4",
        "@types/ws": "8.18.1",
        "cross-env": "10.1.0",
        "typescript": "6.0.3"
    },
    "keywords": [
        "pi-package",
        "pi",
        "pi-extension",
        "pi-coding-agent",
        "pi.dev",
        "coding-agent",
        "remote",
        "web-view",
        "web-push",
        "material-design",
        "mdui"
    ],
    "author": "mjasnikovs <mjasnikovs@googlemail.com>",
    "license": "AGPL-3.0-only",
    "pi": {
        "extensions": ["dist/index.js"]
    }
}
